;; var
(defvar power_menu_open false)
(defvar spotify_panel_open false)

;; include widget
(include "./widget/icon.yuck")
(include "./widget/bar/temperature.yuck")
(include "./widget/bar/system-stats-button.yuck")
(include "./widget/bar/focused-window.yuck")
(include "./widget/bar/workspaces.yuck")
(include "./widget/brightness.yuck")
(include "./widget/tray.yuck")
(include "./widget/battery.yuck")
(include "./widget/updates.yuck")
(include "./widget/control-panel.yuck")
(include "./widget/date-time.yuck")
(include "./widget/power-btn.yuck")
(include "./widget/power-menu.yuck")
(include "./widget/spotify-bar.yuck")
(include "./widget/spotify-panel.yuck")
(include "./widget/keyboard_widget.yuck")

;; include window
(include "./window/system-stats-window.yuck")
(include "./window/volume_indicator_window.yuck")
(include "./window/brightness_indicator_window.yuck")

(defwidget bar []
  (centerbox :orientation "h"
    (left)
    (workspaces)
    (right)))

(defwidget left []
  (box :class "w-left" :orientation "h" :space-evenly false :halign "start" :spacing 0
    (temperature-widget)
    (system-stats-button)
    (spotify-bar)
    (focused-window)))

(defwidget right []
  (box :class "w-right" :orientation "h" :space-evenly false :halign "end" :spacing 0
    (tray-button)
    (updates)
    (keyboard-widget)
    (battery)
    (control-panel-btn)
    (date-time)
    (power-btn)))

(defwindow bar
  :monitor 0
  :stacking "fg"
  :focusable false
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "10px"
                      :anchor "top center")
  :exclusive true
  (bar))
