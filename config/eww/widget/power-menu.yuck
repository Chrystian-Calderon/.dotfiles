(defwindow power-menu
  :monitor 0
  :focusable "ondemand"
  :stacking "overlay"

  :geometry (geometry
    :x "0"
    :y "0"
    :width "100%"
    :height "100%"
    :anchor "center")

  (eventbox
    :onclick "eww close power-menu"

    (box
      :class "power-overlay"
      :halign "center"
      :valign "center"

      ;; evitar cerrar dentro
      (eventbox
        :onclick ""

        (box
          :class "power-content"
          :orientation "horizontal"
          :spacing 1
          :vexpand false
          :hexpand false
          
          (button
            :class "power-item"
            :onclick "hyprlock"
            
            (box
              :orientation "v"
              
              (icon :name "lock" :size 24)
              (label :text "Lock")))
          (button
            :class "power-item"
            :onclick "hyprctl dispatch exit"
            
            (box
              :orientation "v"
              (icon :name "logout" :size 24)
              (label :text "Logout")))
          (button
            :class "power-item"
            :onclick "systemctl suspend"
            
            (box
              :orientation "v"
              (icon :name "moon" :size 24)
              (label :text "Suspend")))
          (button
            :class "power-item"
            :onclick "systemctl reboot"
            
            (box
              :orientation "v"
              (icon :name "reboot" :size 24)
              (label :text "Reboot")))
          (button
            :class "power-item"
            :onclick "systemctl poweroff"
            
            (box
              :orientation "v"
              (icon :name "power" :size 24)
              (label :text "Turn Off")))
        )))))