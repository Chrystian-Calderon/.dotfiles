(defpoll wifi_networks :interval "5s" :initial ""
  "~/.config/eww/scripts/wifi-networks.sh")
(defvar control_panel_open false)
(defvar wifi_expanded false)
(defvar wifi_connected false)
(defvar bluetooth_open false)

(defwidget quick-settings []
  (box
    :class "quick-settings"
    :orientation "v"
    :spacing 16
    :space-evenly false

    ;; volume
    (box
      :class "setting-row"
      :spacing 10

      (icon
        :name "volume-medium"
        :size 20)

      (scale
        :class "setting-scale"
        :min 0
        :max 100
        :value volume
        :draw-value false
        :hexpand true))

    ;; brightness
    (box
      :class "setting-row"
      :spacing 10

      (icon
        :name {brightness >= 50 ? "brightness-up" : "brightness-down"}
        :size 20)

      (scale
        :class "setting-scale"
        :min 0
        :max 100
        :value brightness
        :draw-value false
        :hexpand true))

    ;; wifi
    (box
      :orientation "v"
      :spacing 8

      (button
        :class "toggle-button ${wifi_expanded ? "open" : ""}"
        :onclick "
          if [ \"$(eww get wifi_expanded)\" = \"true\" ]; then
            eww update wifi_expanded=false
          else
            eww update wifi_expanded=true
          fi
        "

        (box
          :spacing 10

          (icon
            :name "network-wireless-symbolic"
            :size 18)

          (label
            :hexpand true
            :xalign 0
            :text "Wi-Fi")

          (label
            :text "${wifi_expanded ? "󰅀" : "󰅂"}")))

      (revealer
        :transition "slidedown"
        :reveal wifi_expanded

        (scroll
          :vscroll true

          (box
            :orientation "v"

            (for network in wifi_networks
              (box
                :class "wifi-networks"
                :orientation "h"
                :spacing 6
                (label :text "${network.ssid}")
                (button
                  :onclick ""
                  (label :text {network.in_use ? "Disconnect" : "Connect"}))
                (revealer
                  :reveal wifi_connected
                  :transition "slidedown"
                  :duration "300ms"
                  (eventbox
                    :onhoverlost "eww update wifi_connected=false"
                    (box
                      :orientation "h"
                      (label :text "${network.ssid}")
                      (input
                        :password true
                        :height 30))))
            ))))))

    ;; bluetooth
    (box
      :orientation "v"
      :spacing 8

      (button
        :class "toggle-button ${bluetooth_open ? "open" : ""}"
        :onclick "eww update bluetooth_open=!${bluetooth_open}"

        (box
          :spacing 10
          :hexpand true

          (icon
            :name "bluetooth-active-symbolic"
            :size 18)

          (label
            :hexpand true
            :xalign 0
            :text "Bluetooth")

          (label
            :text "${bluetooth_open ? "󰅀" : "󰅂"}")))

      (revealer
        :transition "slideup"
        :reveal bluetooth_open

        (box
          :class "connections"
          :orientation "v"
          :spacing 6

          (button :class "connection-item" "Headphones")
          (button :class "connection-item" "Keyboard")
          (button :class "connection-item" "Speaker"))))))

(defwindow control-panel
  :monitor 0
  :geometry (geometry
    :x "5px"
    :y "5px"
    :anchor "top right")
  (box
    :class "control-panel"
    (quick-settings)))

(defwidget control-panel-btn []
  (button
    :class "control-panel-btn"
    :onclick "
      if [ \"$(eww get control_panel_open)\" = \"true\" ]; then
        eww update control_panel_open=false
        eww close control-panel
      else
        eww update control_panel_open=true
        eww open control-panel
      fi
    "

    (icon :name "control" :size 16)))